# MongoDB Atlas — server-only. Never prefix this with NEXT_PUBLIC_
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_DB=sky_plastic

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# One-time admin setup token. Remove it from Vercel after the first admin is created.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-one-time-secret

# Canonical production URL, e.g. https://skyplastic.in
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional Cloudinary signed uploads (recommended for product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional lead email notifications. The sender domain must be verified with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sky Plastic <enquiries@your-verified-domain.example>
LEAD_NOTIFICATION_EMAIL=
